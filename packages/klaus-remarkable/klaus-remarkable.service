[Unit]
Description=Klaus Paper Pure screenshot service
After=home.mount network.target xochitl.service
Wants=xochitl.service

[Service]
Type=simple
EnvironmentFile=/home/root/.config/klaus-remarkable/service.env
ExecStart=/home/root/.vellum/bin/goMarkableStream
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
