maintainer="Billy Gigurtsis <bgigurtsis@users.noreply.github.com>"
pkgname=klaus-remarkable
pkgver=0.1.0
pkgrel=1
upstream_author="bgigurtsis"
category="utilities"
pkgdesc="Manage the Paper Pure screenshot service used by Klaus"
url="https://github.com/bgigurtsis/Klaus"
arch="aarch64"
license="MIT"
depends="gomarkablestream-paperpure mount-utils !rm1 !rm2 !rmpp !rmppm remarkable-os>=3.27 remarkable-os<3.28"
readmeurl="https://github.com/bgigurtsis/Klaus#remarkable-paper-pure"

source="
klaus-remarkable.service
klaus-remarkable-pairing
"

package() {
	install -Dm644 "$srcdir"/klaus-remarkable.service \
		"$pkgdir"/home/root/.vellum/share/klaus-remarkable/klaus-remarkable.service
	install -Dm755 "$srcdir"/klaus-remarkable-pairing \
		"$pkgdir"/home/root/.vellum/bin/klaus-remarkable-pairing
}

install_service() {
	/home/root/.vellum/bin/mount-rw
	trap '/home/root/.vellum/bin/mount-restore' EXIT
	install -Dm644 \
		/home/root/.vellum/share/klaus-remarkable/klaus-remarkable.service \
		/etc/systemd/system/klaus-remarkable.service
	systemctl daemon-reload
	systemctl enable --now klaus-remarkable.service
	/home/root/.vellum/bin/mount-restore
	trap - EXIT
}

reload_framebuffer_bridge() {
	systemctl restart xochitl
	i=0
	while [ "$i" -lt 30 ]; do
		if systemctl is-active --quiet xochitl; then
			return
		fi
		sleep 1
		i=$((i + 1))
	done
	echo "xochitl did not become active after loading the Paper Pure framebuffer bridge" >&2
	return 1
}

ensure_credentials() {
	config_dir=/home/root/.config/klaus-remarkable
	config=$config_dir/service.env
	if [ -s "$config" ]; then
		return
	fi
	umask 077
	mkdir -p "$config_dir"
	password=$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')
	cat > "$config" <<EOF
RK_SERVER_BIND_ADDR=:2001
RK_SERVER_USERNAME=klaus
RK_SERVER_PASSWORD=$password
RK_HTTPS=true
RK_TLS_AUTO_GENERATE=true
RK_TLS_CERT_DIR=$config_dir/certs
RK_JWT_ENABLED=true
RK_JWT_SECRET_DIR=$config_dir/secrets
RK_JWT_TOKEN_LIFETIME=1h
RK_TAILSCALE_ENABLED=false
EOF
	chmod 600 "$config"
}

postinstall() {
	ensure_credentials
	reload_framebuffer_bridge
	install_service
	echo
	/home/root/.vellum/bin/klaus-remarkable-pairing
}

postupgrade() {
	ensure_credentials
	install_service
	systemctl try-restart klaus-remarkable.service
}

postosupgrade() {
	install_service
}

predeinstall() {
	systemctl disable --now klaus-remarkable.service 2>/dev/null || true
	/home/root/.vellum/bin/mount-rw
	trap '/home/root/.vellum/bin/mount-restore' EXIT
	rm -f /etc/systemd/system/klaus-remarkable.service
	systemctl daemon-reload
	/home/root/.vellum/bin/mount-restore
	trap - EXIT
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf /home/root/.config/klaus-remarkable
	fi
}

