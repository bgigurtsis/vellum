maintainer="Billy Gigurtsis <bgigurtsis@users.noreply.github.com>"
pkgname=klaus-remarkable
pkgver=0.1.0
pkgrel=15
upstream_author="bgigurtsis"
category="utilities"
pkgdesc="Manage the Paper Pure screenshot service used by Klaus"
url="https://github.com/bgigurtsis/Klaus"
arch="aarch64"
license="MIT"
depends="gomarkablestream-paperpure mount-utils !rm1 !rm2 !rmpp !rmppm remarkable-os>=3.27 remarkable-os<3.28"
readmeurl="https://github.com/bgigurtsis/Klaus#remarkable-paper-pure"

source="
klaus-remarkable.service
klaus-remarkable-pairing
klaus-remarkable-prepare
"

package() {
	install -Dm644 "$srcdir"/klaus-remarkable.service \
		"$pkgdir"/home/root/.vellum/share/klaus-remarkable/klaus-remarkable.service
	install -Dm755 "$srcdir"/klaus-remarkable-pairing \
		"$pkgdir"/home/root/.vellum/bin/klaus-remarkable-pairing
	install -Dm755 "$srcdir"/klaus-remarkable-prepare \
		"$pkgdir"/home/root/.vellum/bin/klaus-remarkable-prepare
}

install_service() {
	reboot_required=0
	systemctl stop klaus-remarkable.service 2>/dev/null || true
	[ ! -x /home/root/xovi/stock ] || /home/root/xovi/stock
	if grep -q '^overlay.*/etc' /proc/mounts; then
		mount --make-private /etc
	fi
	if ! /home/root/.vellum/bin/mount-rw; then
		sleep 2
		/home/root/.vellum/bin/mount-rw
	fi
	trap '/home/root/.vellum/bin/mount-restore' EXIT
	mkdir -p /etc/systemd/system/multi-user.target.wants
	rm -f /etc/systemd/system/klaus-remarkable.service
	cp /home/root/.vellum/share/klaus-remarkable/klaus-remarkable.service \
		/etc/systemd/system/klaus-remarkable.service
	chmod 644 /etc/systemd/system/klaus-remarkable.service
	ln -sfn /etc/systemd/system/klaus-remarkable.service \
		/etc/systemd/system/multi-user.target.wants/klaus-remarkable.service
	if ! /home/root/.vellum/bin/mount-restore; then
		reboot_required=1
	fi
	trap - EXIT
	[ ! -x /home/root/xovi/start ] || /home/root/xovi/start
	systemctl daemon-reload
	systemctl enable --now klaus-remarkable.service
	if [ "$reboot_required" = "1" ]; then
		echo "Restart Paper Pure to restore its read-only system."
	fi
}

ensure_credentials() {
	config_dir=/home/root/.config/klaus-remarkable
	config=$config_dir/service.env
	if [ -s "$config" ] &&
		grep -q '^RK_SERVER_USERNAME=..*' "$config" &&
		grep -q '^RK_SERVER_PASSWORD=..*' "$config"; then
		return
	fi
	umask 077
	mkdir -p "$config_dir"
	password=$(/usr/bin/openssl rand -hex 24)
	cat > "$config" <<EOF
RK_SERVER_BIND_ADDR=:2001
RK_SERVER_USERNAME=klaus
RK_SERVER_PASSWORD=$password
RK_HTTPS=true
RK_TLS_AUTO_GENERATE=true
RK_TLS_CERT_DIR=$config_dir/certs
RK_JWT_ENABLED=true
RK_JWT_SECRET_DIR=$config_dir/secrets
RK_JWT_TOKEN_LIFETIME=1h
RK_TAILSCALE_ENABLED=false
EOF
	chmod 600 "$config"
}

postinstall() {
	ensure_credentials
	install_service
	echo "Paper Pure service installed. Run klaus-remarkable-pairing to display pairing details."
}

postupgrade() {
	ensure_credentials
	install_service
	systemctl try-restart klaus-remarkable.service
}

postosupgrade() {
	install_service
}

predeinstall() {
	reboot_required=0
	systemctl disable --now klaus-remarkable.service 2>/dev/null || true
	[ ! -x /home/root/xovi/stock ] || /home/root/xovi/stock
	if grep -q '^overlay.*/etc' /proc/mounts; then
		mount --make-private /etc
	fi
	if ! /home/root/.vellum/bin/mount-rw; then
		sleep 2
		/home/root/.vellum/bin/mount-rw
	fi
	trap '/home/root/.vellum/bin/mount-restore' EXIT
	rm -f /etc/systemd/system/klaus-remarkable.service
	rm -f /etc/systemd/system/multi-user.target.wants/klaus-remarkable.service
	if ! /home/root/.vellum/bin/mount-restore; then
		reboot_required=1
	fi
	trap - EXIT
	[ ! -x /home/root/xovi/start ] || /home/root/xovi/start
	systemctl daemon-reload
	if [ "$reboot_required" = "1" ]; then
		echo "Restart Paper Pure to restore its read-only system."
	fi
	if [ "$VELLUM_PURGE" = "1" ]; then
		rm -rf /home/root/.config/klaus-remarkable
	fi
}

